[Unit]
Description=On CI workflow worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/on
EnvironmentFile=-/etc/on/worker.env
ExecStart=/usr/bin/on start-workers
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
