{
  "name": "@cloud-cli/on",
  "version": "1.2.1",
  "description": "CLI entry point for the on plugin ecosystem.",
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "license": "MIT",
  "exports": {
    "./*": {
      "types": "./dist/*",
      "default": "./dist/*"
    }
  },
  "files": ["dist"],
  "main": "dist/on.js",
  "bin": {
    "on": "dist/on.js"
  },
  "dependencies": {
    "acorn": "^8.18.0",
    "ansi_up": "^6.0.6",
    "dotenv": "^17.4.2",
    "yaml": "^2.9.0"
  },
  "scripts": {
    "ci": "pnpm build && pnpm lint && pnpm test",
    "build": "vite build && tsc --emitDeclarationOnly --declaration",
    "lint": "eslint .",
    "test": "echo true || npm wf start",
    "wf": "pnpm tsx src/index.ts -w tests -p 11235"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "tsx": "^4.23.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
