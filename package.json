{
  "name": "@cloud-cli/on",
  "version": "1.2.1",
  "description": "CLI entry point for the on plugin ecosystem.",
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "license": "MIT",
  "exports": {
    "./*": "./dist/*"
  },
  "files": ["dist"],
  "main": "dist/index.js",
  "bin": {
    "on": "dist/index.js"
  },
  "dependencies": {
    "acorn": "^8.17.0",
    "ansi_up": "^6.0.6",
    "dotenv": "^17.4.2",
    "yaml": "^2.8.2"
  },
  "scripts": {
    "nx": "nx",
    "build": "nx run-many -t build",
    "lint": "nx run-many -t lint",
    "test": "nx run-many -t test && pnpm test-wf",
    "test-wf": "pnpm wf start",
    "wf": "pnpm tsx packages/on/src/index.ts -w tests -p 11235"
  },
  "devDependencies": {
    "@changesets/cli": "2.30.0",
    "@eslint/js": "10.0.1",
    "@types/node": "^26.0.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.0",
    "@typescript-eslint/eslint-plugin": "8.57.1",
    "@typescript-eslint/parser": "8.57.1",
    "typescript-eslint": "8.57.1",
    "vite": "^7.3.5",
    "vitest": "4.1.0"
  }
}
