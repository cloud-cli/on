{
  "compilerOptions": {
    "rootDir": "./src/",
    "outDir": "dist/",
    "lib": ["dom", "esnext"],
    "noImplicitAny": false,
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["node"],
  },
  "include": ["src/**/*.ts"],
  "exclude": ["**/dist/**/*", "node_modules", "src/**/*.spec.ts"],
}
