{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://runner.example.com/workflow.schema.json",
  "title": "WorkflowDefinition",
  "type": "object",
  "required": ["name", "steps"],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "description": "Human-readable name for the workflow."
    },

    "tags": {
      "type": "array",
      "description": "Worker capability tags required to execute this workflow.",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },

    "includes": {
      "type": "array",
      "description": "List of partial YAML files to merge into this workflow before execution.",
      "items": {
        "type": "string"
      }
    },

    "on": {
      "type": "object",
      "description": "Trigger conditions and provider configs.",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "if": {
            "description": "AST boolean condition expression",
            "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" } }]
          },
          "events": { "type": "array", "items": { "type": "string" } },
          "owner": {
            "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" } }]
          },
          "repo": {
            "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" } }]
          },
          "branches": { "type": "array", "items": { "type": "string" } },
          "tag": { "type": "boolean" },
          "tags": { "type": "array", "items": { "type": "string" } },
          "paths": { "type": "array", "items": { "type": "string" } }
        }
      }
    },

    "concurrency": {
      "type": "object",
      "required": ["group"],
      "properties": {
        "group": { "type": "string" },
        "cancel-in-progress": { "type": "boolean", "default": false }
      }
    },

    "env": {
      "type": "object",
      "description": "Global environment variables available across all steps.",
      "additionalProperties": { "type": "string" }
    },

    "matrix": {
      "type": "object",
      "description": "Generates multiple workflow variants across dimension arrays.",
      "additionalProperties": {
        "type": "array",
        "items": { "type": ["string", "number", "boolean"] }
      }
    },

    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/Step"
      }
    },

    "artifacts": {
      "type": "object",
      "required": ["paths"],
      "properties": {
        "paths": {
          "type": "array",
          "items": { "type": "string" }
        },
        "retention": {
          "type": "string",
          "pattern": "^[0-9]+[dhm]$",
          "description": "Retention duration (e.g., 7d, 24h)"
        }
      }
    }
  },

  "definitions": {
    "Step": {
      "type": "object",
      "required": ["id", "name"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$" },
        "name": { "type": "string" },
        "if": { "type": "string" },
        "image": { "type": "string", "description": "Docker container image" },
        "env": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "timeoutMs": { "type": "integer", "minimum": 1000 },
        "run": { "type": "string", "description": "Shell/Docker script execution" },
        "eval": { "type": "string", "description": "In-process JS function execution" }
      },
      "oneOf": [
        { "required": ["run"], "not": { "required": ["eval"] } },
        { "required": ["eval"], "not": { "required": ["run"] } }
      ]
    }
  }
}
