{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://runner.example.com/recipe.schema.json",
  "title": "RecipeDefinition",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "inputs": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type"],
          "properties": { "type": { "const": "object" } },
          "additionalProperties": true
        },
        {
          "type": "object",
          "description": "Map of ordinary input declarations.",
          "additionalProperties": {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": {
                "enum": ["string", "number", "integer", "boolean", "object", "array", "null"]
              },
              "required": { "type": "boolean" }
            },
            "additionalProperties": true
          }
        }
      ]
    },
    "secrets": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          { "enum": ["string", "file"] },
          {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": { "enum": ["string", "file"] },
              "required": { "type": "boolean" }
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "env": { "type": "object" },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "not": { "required": ["using"] }
      }
    },
    "functions": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
      "additionalProperties": {
        "type": "object",
        "required": ["inputs", "outputs", "steps"],
        "additionalProperties": false,
        "properties": {
          "inputs": {
            "type": "object",
            "required": ["type"],
            "properties": { "type": { "const": "object" } },
            "additionalProperties": true
          },
          "secrets": { "$ref": "#/properties/secrets" },
          "outputs": { "$ref": "#/properties/inputs" },
          "steps": { "$ref": "#/properties/steps" }
        }
      }
    }
  },
  "oneOf": [
    { "required": ["steps"], "not": { "required": ["functions"] } },
    {
      "required": ["functions"],
      "not": {
        "anyOf": [{ "required": ["inputs"] }, { "required": ["secrets"] }, { "required": ["steps"] }]
      }
    }
  ]
}
