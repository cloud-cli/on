{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://runner.example.com/recipe.schema.json",
  "title": "RecipeDefinition",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "inputs": {
      "type": "object",
      "required": ["type"],
      "description": "Draft-07 JSON Schema for ordinary recipe inputs. Top-level properties marked writeOnly are secret inputs.",
      "properties": {
        "type": { "const": "object" }
      },
      "additionalProperties": true
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "not": { "anyOf": [{ "required": ["using"] }, { "required": ["secrets"] }] }
      }
    },
    "functions": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
      "additionalProperties": {
        "type": "object",
        "required": ["inputs", "outputs", "steps"],
        "additionalProperties": false,
        "properties": {
          "inputs": { "$ref": "#/properties/inputs" },
          "outputs": { "$ref": "#/properties/inputs" },
          "steps": { "$ref": "#/properties/steps" }
        }
      }
    }
  },
  "oneOf": [
    { "required": ["inputs", "steps"], "not": { "required": ["functions"] } },
    { "required": ["functions"], "not": { "anyOf": [{ "required": ["inputs"] }, { "required": ["steps"] }] } }
  ]
}
